+    static func resolveEndpoint(_ base: String, apiProtocol: String) -> String {
+        let raw = base.trimmingCharacters(in: .whitespacesAndNewlines)
+        // 空串 → 返回空，由调用方 URL(string:) 判失败（避免拼出 "v1/chat/completions" 这种脏串）
