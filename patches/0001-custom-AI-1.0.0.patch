+        guard let url = URL(string: trimmed) else { return trimmed + "/models" }
+        let path = url.path
+        if path.isEmpty || path == "/" { return trimmed + "/v1/models" }   // 纯主机 → /v1/models
+        return trimmed + "/models"
+    }
